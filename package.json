{
  "name": "@yijie/infra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "validate": "pnpm validate:compose && pnpm validate:feat-125-local-assets && pnpm validate:feat-125-local-template && pnpm validate:feat-125-template && pnpm validate:feat-126-s10",
    "validate:compose": "node scripts/validate-compose.mjs",
    "validate:feat-125-local-assets": "node scripts/validate-feat-125-local-assets.mjs",
    "validate:feat-125-local-template": "node scripts/validate-feat-125-local.mjs --mode template environments/local/feat-125.local-lab.template.yaml",
    "validate:feat-125-template": "node scripts/validate-feat-125-nonprod.mjs --mode template environments/nonproduction/feat-125.template.yaml",
    "validate:feat-126-s10": "node scripts/validate-feat-126-s10.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "yaml": "2.9.0"
  }
}
